# Copie para .env e preencha. Nunca versione o .env.

# Servidor
NODE_ENV=development
PORT=3000
# Origens autorizadas (separadas por vírgula). Obrigatório em produção.
CORS_ORIGINS=http://localhost:3000
# Número de proxies reversos na frente da API (0 = nenhum). Necessário para o rate limit por IP.
TRUST_PROXY=0

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# JWT — mínimo de 32 caracteres cada, valores diferentes entre si.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_SECRET2=

# SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
